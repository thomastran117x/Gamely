# Copy this file to .env at the repository root before starting Docker Compose.
# Do not commit real AWS credentials.
#
# This file holds only secrets, credential-bearing connection URLs, and the
# values Docker Compose itself reads. Every non-secret backend default lives in
# backend/config/default.yml, with per-stage overrides in backend/config/
# {dev,test,prod}.yml. Anything set here overrides those files; see
# backend/config/default.yml for the full precedence order.

# Backend configuration stage: dev, test, or prod. Selects backend/config/<stage>.yml.
APP_ENV=dev

# Public domain composed into backend/config/prod.yml (CORS origins, cookie
# domain). Required when APP_ENV=prod; ignored by the other stages.
# APP_DOMAIN=games.example

# --- Docker Compose only (not read by the backend) ---
POSTGRES_DB=games
POSTGRES_USER=games
POSTGRES_PASSWORD=games
POSTGRES_PORT=5432
REDIS_PORT=6379
OPENSEARCH_PORT=9200
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=games
RABBITMQ_DEFAULT_PASS=games
FRONTEND_PORT=3040
BACKEND_PORT=8040
API_BASE_URL=http://api:8000

# --- Connection URLs (embed credentials) ---
DATABASE_URL=postgresql+asyncpg://games:games@postgres:5432/games
REDIS_URL=redis://redis:6379/0
OPENSEARCH_URL=http://opensearch:9200
RABBITMQ_URL=amqp://games:games@rabbitmq:5672/

# --- AWS ---
AWS_REGION=ca-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_BUCKET=

# --- Secrets ---
# Required. Must be at least 32 characters.
AUTH_JWT_SECRET=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- OAuth client IDs (public identifiers, but deployment-specific) ---
GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
APPLE_CLIENT_ID=
