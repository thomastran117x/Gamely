# Copy this file to .env at the repository root before starting Docker Compose.
# Do not commit real AWS credentials.

POSTGRES_DB=games
POSTGRES_USER=games
POSTGRES_PASSWORD=games
POSTGRES_PORT=5432
REDIS_PORT=6379
OPENSEARCH_PORT=9200
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=games
RABBITMQ_DEFAULT_PASS=games
FRONTEND_PORT=3040
BACKEND_PORT=8040
API_BASE_URL=http://api:8000
CORS_ORIGINS=http://localhost:3040,http://127.0.0.1:3040

DATABASE_URL=postgresql+asyncpg://games:games@postgres:5432/games
REDIS_URL=redis://redis:6379/0
OPENSEARCH_URL=http://opensearch:9200
RABBITMQ_URL=amqp://games:games@rabbitmq:5672/

AWS_REGION=ca-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_BUCKET=

AUTH_JWT_SECRET=change-this-development-secret-to-at-least-32-characters
AUTH_JWT_ISSUER=games-api
AUTH_JWT_AUDIENCE=games-api
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_CODE_MINUTES=10
AUTH_REFRESH_COOKIE_NAME=games_refresh
AUTH_REFRESH_COOKIE_PATH=/auth
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_SAMESITE=lax
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
EMAIL_WORKER_CONCURRENCY=10
GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=
APPLE_CLIENT_ID=
